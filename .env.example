# --- API (deixe vazio para usar os dados de demonstração) -------------------
# Saída "ApiUrl" do deploy do backend (sem barra no final).
VITE_API_URL=

# --- Login (Amazon Cognito). Vazio = login de demonstração ------------------
# Saídas "Region" e "UserPoolClientId" do deploy do backend.
VITE_COGNITO_REGION=
VITE_COGNITO_CLIENT_ID=

# Minutos sem atividade até encerrar a sessão (padrão 15).
VITE_IDLE_MINUTES=
